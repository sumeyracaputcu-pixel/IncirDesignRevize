@{
    ViewData["Title"] = "Erişim Engellendi";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card shadow border-danger">

                <div class="card-body p-5">

                    @* Büyük Uyarı İkonu *@
                    <div class="mb-4">
                        <i class="bi bi-shield-x text-danger" style="font-size: 5rem;"></i>
                    </div>

                    @* Başlık *@
                    <h2 class="text-danger mb-3">Erişim Engellendi!</h2>

                    @* Açıklama *@
                    <p class="lead text-muted mb-4">
                        Bu sayfayı görüntülemek için yetkiniz bulunmamaktadır.
                        <br />
                        Lütfen sistem yöneticinizle iletişime geçin.
                    </p>

                    @* Ana Sayfaya Dön Butonu *@
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-house me-2"></i>Ana Sayfaya Dön
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>
