@model IncirDesignRevize1.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Üye Ol";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            @* ═══════════════════════════════════════════════════════════════ *@
            @* KART YAPISI - Bootstrap Card Bileşeni *@
            @* ═══════════════════════════════════════════════════════════════ *@
            <div class="card shadow">

                @* Kart Başlığı *@
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>Üye Ol
                    </h4>
                </div>

                @* Kart Gövdesi *@
                <div class="card-body p-4">

                    @* ─────────────────────────────────────────────────────────
                           HATA MESAJLARI
                           Controller'da ModelState.AddModelError ile eklenen hatalar
                           burada görünür
                        ───────────────────────────────────────────────────────── *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                         role="alert"></div>

                    @* ─────────────────────────────────────────────────────────
                           FORM BAŞLANGICI
                           asp-action: Form gönderildiğinde hangi action çalışsın
                           asp-controller: Hangi controller'a gitsin
                        ───────────────────────────────────────────────────────── *@
                    <form asp-action="Register" asp-controller="Account" method="post">

                        @* AD ALANI *@
                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label"></label>
                            <input asp-for="Ad" class="form-control" placeholder="Adınızı giriniz" />
                            <span asp-validation-for="Ad" class="text-danger small"></span>
                        </div>

                        @* SOYAD ALANI *@
                        <div class="mb-3">
                            <label asp-for="Soyad" class="form-label"></label>
                            <input asp-for="Soyad" class="form-control" placeholder="Soyadınızı giriniz" />
                            <span asp-validation-for="Soyad" class="text-danger small"></span>
                        </div>

                        @* E-POSTA ALANI *@
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        @* ŞİFRE ALANI *@
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" placeholder="En az 6 karakter" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        @* ŞİFRE TEKRAR ALANI *@
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar giriniz" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        @* GÖNDER BUTONU *@
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Üye Ol
                            </button>
                        </div>

                    </form>
                </div>

                @* Kart Alt Bilgisi *@
                <div class="card-footer text-center py-3 bg-light">
                    <span class="text-muted">Zaten üye misiniz?</span>
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none ms-1">
                        Giriş Yapın
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════ *@
@* CLIENT-SIDE VALIDATION (Tarayıcı Tarafı Doğrulama) *@
@* Form gönderilmeden önce kontrol yapar *@
@* ═══════════════════════════════════════════════════════════════ *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

