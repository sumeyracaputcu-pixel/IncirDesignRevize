@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - İncirDesign</title>

    @* Bootstrap 5 CSS *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    @* Bootstrap Icons *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-dM8B0BQ+36PTlH5t3O7v+1cC4rjRUP7u0uN2rZDjVd+NwJfH+5lMe4kp6OciTG0aO3cZltc8zbhk5My1rZj+vA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
</head>
<body>

    @* ═══════════════════════════════════════════════════════════════ *@
    @* NAVİGASYON MENÜSÜ *@
    @* ═══════════════════════════════════════════════════════════════ *@
    <!-- Start Top Nav -->
    <nav class="navbar navbar-expand-lg bg-dark navbar-light d-none d-lg-block" id="templatemo_nav_top">
        <div class="container text-light">
            <div class="w-100 d-flex justify-content-between">
                <div>
                    <i class="fa fa-envelope mx-2"></i>
                    <a class="navbar-sm-brand text-light text-decoration-none" href="mailto:incirdesign@gmail.com">incirdesign@gmail.com</a>
                    <i class="fa fa-phone mx-2"></i>
                    <a class="navbar-sm-brand text-light text-decoration-none" href="tel:0545 771 29 23">0545 771 29 23</a>
                </div>
                <div>
                    <a class="text-light" href="https://fb.com/incirdesign" target="_blank" rel="sponsored"><i class="fab fa-facebook-f fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://www.instagram.com/incirartstudio" target="_blank"><i class="fab fa-instagram fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://www.x.com/incirdesign" target="_blank"><i class="fab fa-twitter fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://www.linkedin.com/incirdesign" target="_blank"><i class="fab fa-linkedin fa-sm fa-fw"></i></a>
                </div>
            </div>
        </div>
    </nav>
    <!-- Close Top Nav -->
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container">

            @* Logo / Site Adı *@
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.jpeg" alt="IncirDesign Logo" style="height:50px; margin-right:10px;"><strong>İncirDesign</strong>
            </a>

            @* Mobil Menü Butonu *@
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                @* ─────────────────────────────────────────────────────────
                       SOL MENÜ - Herkesin Görebildiği
                    ───────────────────────────────────────────────────────── *@
                <ul class="navbar-nav mx-auto d-flex flex-row text-center">
                    <li class="nav-item mx-3">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Ana Sayfa
                        </a>
                    </li>
                    <li class="nav-item mx-3">
                        <a class="nav-link d-flex justify-content-center align-items-center" asp-controller="Home" asp-action="Hakkımızda">
                            <i class="bi bi-building me-1"></i> Hakkımızda
                        </a>
                    </li>
                    <li class="nav-item mx-3">
                        <a class="nav-link d-flex justify-content-center align-items-center" asp-controller="Home" asp-action="Alışveriş">
                            <i class="bi bi-cart me-1"></i> Alışveriş
                        </a>
                    </li>
                    <li class="nav-item mx-3">
                        <a class="nav-link d-flex justify-content-center align-items-center" asp-controller="Home" asp-action="İletişim">
                            <i class="bi bi-telephone me-1"></i> İletişim
                        </a>
                    </li>
                </ul>

                @* ─────────────────────────────────────────────────────────
                       SAĞ MENÜ - Giriş Durumuna Göre Değişen
                    ───────────────────────────────────────────────────────── *@
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Favorite" asp-action="Index">
                            <i class="bi bi-heart fs-5"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Sepet" asp-action="Index">
                            <i class="bi bi-cart fs-5"></i>
                        </a>
                    </li>

                    @* ═══════════════════════════════════════════════════════
                           KULLANICI GİRİŞ YAPMIŞ MI?
                           SignInManager.IsSignedIn(User) ile kontrol ediyoruz
                        ═══════════════════════════════════════════════════════ *@
                    @if (SignInManager.IsSignedIn(User))
                    {
                        @* ─────────────────────────────────────────────────
                               GİRİŞ YAPMIŞ - ROLE GÖRE MENÜLER
                            ───────────────────────────────────────────────── *@

                        @* Üye Alanı - Giriş yapmış herkes görebilir *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Uye" asp-action="Index">
                                <i class="bi bi-person-circle me-1"></i>Üye Alanı
                            </a>
                        </li>


                     

                        @* ═══════════════════════════════════════════════════
                               ADMİN MENÜSÜ
                               SADECE Admin rolündekiler görebilir
                            ═══════════════════════════════════════════════════ *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin Paneli
                                </a>
                            </li>
                        }

                        @* ─────────────────────────────────────────────────
                               KULLANICI DROPDOWN MENÜSÜ
                            ───────────────────────────────────────────────── *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-person-fill me-1"></i>
                                @* Kullanıcının adını göster *@
                                @{
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    var displayName = currentUser != null
                                    ? $"{currentUser.Ad} {currentUser.Soyad}"
                                    : User.Identity?.Name;
                                }
                                @displayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Uye" asp-action="Profil">
                                        <i class="bi bi-person me-2"></i>Profilim
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @* ─────────────────────────────────────────
                                           ÇIKIŞ FORMU
                                           POST metodu kullanıyoruz (güvenlik için)
                                        ───────────────────────────────────────── *@
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                   
                   
                        @* ─────────────────────────────────────────────────
                               GİRİŞ YAPMAMIŞ - Giriş/Kayıt Butonları
                            ───────────────────────────────────────────────── *@
                    else
                         {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                            <i class="bi bi-person-plus me-2"></i>Üye Ol
                                        </a>
                                    </li>
                                </ul>
                            </li>
                         }

                </ul>
            </div>
        </div>
    </nav>

    @* ═══════════════════════════════════════════════════════════════ *@
    @* ANA İÇERİK ALANI *@
    @* ═══════════════════════════════════════════════════════════════ *@
    <main class="pb-5">
        @RenderBody()
    </main>

    @* ═══════════════════════════════════════════════════════════════ *@
    <!-- Start Footer -->
    <footer class="bg-dark" id="tempaltemo_footer">
        <div class="container">
            <div class="row">

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-success border-bottom pb-3 border-light logo">İncirDesign</h2>
                    <ul class="list-unstyled text-light footer-link-list">
                        <li>
                            <i class="fas fa-map-marker-alt fa-fw"></i>
                            Merkezefendi / Denizli
                        </li>
                        
                        <li>
                            <i class="fa fa-phone fa-fw"></i>
                            <a class="text-decoration-none text-light" href="tel:0545 771 29 23">0545 771 29 23</a>
                        </li>
                        
                        <li>
                            <i class="fa fa-envelope fa-fw"></i>
                            <a class="text-decoration-none text-light" href="mailto:incirdesign@gmail.com">incirdesign@gmail.com</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-light border-bottom pb-3 border-light">Ürünler</h2>
                    <ul class="list-unstyled text-light footer-link-list">
                        <li><a class="text-decoration-none text-light" href="#">Minimal Okey Istaka Seti</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">Çizgifilm Temalı Okey Istaka Seti</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">Film Karakterleri Okey Istaka Seti</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">İsim Yazılı Istaka Seti</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">Karikatür Istaka Seti</a></li>

                    </ul>
                </div>

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-light border-bottom pb-3 border-light">Daha Fazla Bilgi</h2>
                    <ul class="list-unstyled text-light footer-link-list">
                        <li><a class="text-decoration-none text-light" href="#">Ana Sayfa</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">Hakkımızda</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">Mağaza Adresi</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">SSS</a></li>
                        
                        <li><a class="text-decoration-none text-light" href="#">İletişim</a></li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="w-100 bg-black py-3">
            <div class="container">
                <div class="row pt-2">
                    <div class="col-12">
                        <p class="text-center text-light">
                            2026 İncirDesign - Tüm Hakları Saklıdır.

                        </p>
                    </div>
                </div>
            </div>
        </div>

    </footer>
    <!-- End Footer -->
    @* Bootstrap 5 JS *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>